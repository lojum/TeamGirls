<Window x:Class="SmartLib.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registration"
        Width="920" Height="600"
        WindowStartupLocation="CenterScreen"
        Background="White"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#243746"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8E0E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PasswordInputStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#243746"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8E0E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#34495A"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style x:Key="FieldErrorStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="45*"/>
            <ColumnDefinition Width="55*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0"
               Source="Images/left-panel-hero.jpg"
               Stretch="UniformToFill"/>

        <Grid Grid.Column="1" Background="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid MinHeight="600">
                    <StackPanel Width="380"
                                MaxWidth="380"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="40,36">
                        <TextBlock Text="Create your account"
                                   FontSize="29"
                                   FontWeight="Bold"
                                   Foreground="#173B59"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Join our library community and start exploring."
                                   FontSize="14"
                                   Foreground="#718096"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,24"/>

                        <TextBlock Text="Full Name" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="NameInput"
                                 Style="{StaticResource InputStyle}"
                                 Margin="0,0,0,4"
                                 TextChanged="NameInput_TextChanged"/>
                        <TextBlock x:Name="NameErrorText" Style="{StaticResource FieldErrorStyle}"/>

                        <TextBlock Text="Email" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,7"/>
                        <TextBox x:Name="EmailInput"
                                 Style="{StaticResource InputStyle}"
                                 Margin="0,0,0,4"
                                 TextChanged="EmailInput_TextChanged"/>
                        <TextBlock x:Name="EmailErrorText" Style="{StaticResource FieldErrorStyle}"/>

                        <TextBlock Text="Password" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,7"/>
                        <PasswordBox x:Name="PasswordInput"
                                     Style="{StaticResource PasswordInputStyle}"
                                     Margin="0,0,0,4"
                                     PasswordChanged="PasswordInput_PasswordChanged"/>
                        <TextBlock x:Name="PasswordErrorText" Style="{StaticResource FieldErrorStyle}"/>

                        <TextBlock Text="Confirm Password" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,7"/>
                        <PasswordBox x:Name="ConfirmPasswordInput"
                                     Style="{StaticResource PasswordInputStyle}"
                                     Margin="0,0,0,4"
                                     PasswordChanged="ConfirmPasswordInput_PasswordChanged"/>
                        <TextBlock x:Name="ConfirmPasswordErrorText" Style="{StaticResource FieldErrorStyle}" Margin="0,4,0,16"/>

                        <Button x:Name="RegisterSubmitBtn"
                                Content="Create Account"
                                Height="48"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Background="#246B8E"
                                Foreground="White"
                                BorderThickness="0"
                                IsEnabled="False"
                                Cursor="Hand"
                                Margin="0,0,0,8"
                                Click="RegisterSubmitBtn_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button x:Name="BackBtn"
                                Content="Back to Welcome Screen"
                                Height="40"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Background="Transparent"
                                Foreground="#246B8E"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BackBtn_Click"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
