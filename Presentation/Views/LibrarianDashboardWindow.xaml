<Window x:Class="Presentation.Views.LibrarianDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLib - Librarian Dashboard" Height="900" Width="1440" MinHeight="650" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F4F6F8"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{Binding LibrarianName, StringFormat='Welcome, {0} (Librarian)'}" FontSize="18" FontWeight="Bold"/>
            <Button Content="Exit" Command="{Binding LogoutCommand}" HorizontalAlignment="Right" Width="80" Padding="5"/>
        </DockPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Width="300">
            <TextBlock Text="Issue Book" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" TextAlignment="Center"/>
            
            <TextBlock Text="Reader Email:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox Text="{Binding ReaderEmail, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,15"/>
            
            <TextBlock Text="Inventory Number:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox Text="{Binding InventoryNumber, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,20"/>
            
            <Button Content="Issue Book" Command="{Binding IssueBookCommand}" Padding="10" Background="#4CAF50" Foreground="White" FontWeight="Bold" FontSize="14"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" TextAlignment="Center" FontSize="14" Margin="0,20,0,0" FontWeight="SemiBold">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="Green"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Foreground" Value="Red"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</Window>