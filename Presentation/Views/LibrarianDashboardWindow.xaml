<Window x:Class="Presentation.Views.LibrarianDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLib — Librarian Workspace"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F1F1F1"
        FontFamily="Segoe UI"
        FontSize="12">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#0879D9"/>
        <SolidColorBrush x:Key="LineBrush" Color="#D2D4D7"/>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Foreground" Value="#26282B"/>
            <Setter Property="BorderBrush" Value="#C9CBCD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="StatusBadgeStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#18733A"/>
            <Setter Property="Background" Value="#E3F4E8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Checked Out">
                    <Setter Property="Foreground" Value="#BC3434"/>
                    <Setter Property="Background" Value="#FCE8E8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Reserved">
                    <Setter Property="Foreground" Value="#A76A16"/>
                    <Setter Property="Background" Value="#FFF2D7"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E9EAEC"/>
            <Setter Property="Foreground" Value="#323438"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="7,6"/>
            <Setter Property="BorderBrush" Value="#D1D3D5"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="BorderBrush" Value="#E1E2E4"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="27"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F8F9FA"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0879D9"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding IssueBookCommand}"/>
    </Window.InputBindings>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#ECEDEF" BorderBrush="#C7C9CB" BorderThickness="0,0,0,1">
            <DockPanel Margin="10,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource AccentBrush}" Margin="0,0,8,0">
                        <TextBlock Text="▣" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                    </Border>
                    <TextBlock Text="SmartLib v2.5 — Librarian Workspace" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="  [Active Session]" Foreground="#6C7075" VerticalAlignment="Center"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="●" Width="22" Height="22" Margin="4,0"
                        Background="Transparent" Foreground="#C73535" BorderThickness="0" ToolTip="Log out"
                        Command="{Binding LogOutCommand}"/>
            </DockPanel>
        </Border>

        <Menu DockPanel.Dock="Top" Background="#F8F8F8" BorderBrush="#D4D5D6" BorderThickness="0,0,0,1">
            <MenuItem Header="_File">
                <MenuItem Header="New Book"/>
                <Separator/>
                <MenuItem Header="Log Out" Command="{Binding LogOutCommand}"/>
            </MenuItem>
            <MenuItem Header="_Edit"/>
            <MenuItem Header="_View"/>
            <MenuItem Header="_Patrons"/>
            <MenuItem Header="_Inventory"/>
            <MenuItem Header="_Catalog"/>
            <MenuItem Header="_Reports"/>
            <MenuItem Header="_Tools"/>
            <MenuItem Header="_Help"/>
        </Menu>

        <Border DockPanel.Dock="Bottom" Background="#F8F8F8" BorderBrush="#C8CACC" BorderThickness="0,1,0,0" Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="●" Margin="0,0,6,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#1F9D55"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="#BC3434"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#55595E"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding LoggedInAs}" Foreground="#50545A" Margin="20,0"/>
                <TextBlock Grid.Column="2" Text="Connected to SmartLib database" Foreground="#85898E"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Background="#F7F7F7" BorderBrush="#D0D2D4" BorderThickness="0,0,0,1" Padding="10,7">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="＋  New Book" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="⇧  Import ISBN" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="▣  Delete Selected" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="⟳  Refresh Grid" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding RefreshCommand}"/>
                    <Button Content="⇩  Export to CSV" Style="{StaticResource ToolbarButtonStyle}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="Quick Search:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Width="220" Height="28" Padding="7,3" VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search by title, author, ISBN or inventory number"/>
                    <Button Content="⌕  Search" Margin="5,0,12,0"
                            Background="{StaticResource AccentBrush}" Foreground="White"
                            BorderThickness="0" Padding="12,0" Height="28" Cursor="Hand"/>
                    <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="125" Height="28" ItemsSource="{Binding StatusFilters}"
                              SelectedItem="{Binding SelectedStatus, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.15*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid Grid.Column="0" Grid.Row="0"
                      ItemsSource="{Binding Books}"
                      SelectedItem="{Binding SelectedBook, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      AlternationCount="2"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      BorderBrush="#BFC2C5"
                      BorderThickness="1"
                      Background="White"
                      RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Inventory No." Binding="{Binding BookId}" Width="95"/>
                    <DataGridTextColumn Header="Book Title" Binding="{Binding Title}" Width="2.1*"/>
                    <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="1.25*"/>
                    <DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="1.35*"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="0.95*"/>
                    <DataGridTemplateColumn Header="Status" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource StatusBadgeStyle}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Grid.Row="0" Width="6" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"/>

            <StackPanel Grid.Column="2" Grid.Row="0">
                <Border Background="White" BorderBrush="#BFC2C5" BorderThickness="1" Padding="12">
                    <StackPanel>
                        <TextBlock Text="♙  Issue Book (New Loan Entry)" FontWeight="Bold" Foreground="#30343A" Margin="0,0,0,12"/>

                        <TextBlock Text="1. Select Reader (Name / Email)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding Readers}" SelectedItem="{Binding SelectedReader}"
                                  DisplayMemberPath="Display" Height="30" Padding="5,4"/>

                        <TextBlock Text="2. Select Book (available copies only)" FontWeight="SemiBold" Margin="0,13,0,5"/>
                        <ComboBox ItemsSource="{Binding AvailableBooks}" SelectedItem="{Binding SelectedBook, Mode=TwoWay}"
                                  Height="30" Padding="5,4">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding BookId, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding Title, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="3. Loan Duration" FontWeight="SemiBold" Margin="0,13,0,5"/>
                        <ComboBox ItemsSource="{Binding LoanDurations}" SelectedItem="{Binding SelectedDuration}"
                                  DisplayMemberPath="Label" Height="30" Padding="5,4"/>

                        <TextBlock Text="4. Auto-Calculated Due Date" FontWeight="SemiBold" Margin="0,13,0,5"/>
                        <TextBox Text="{Binding CalculatedDueDate, Mode=OneWay}" IsReadOnly="True" Height="29" Padding="6,4"
                                 Background="#F5F5F5" BorderBrush="#C8CACC"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Content="⟲  Reset Form" Height="32"
                                    Padding="10,0" Margin="0,0,7,0" Background="#F5F5F5"
                                    BorderBrush="#C8CACC" Cursor="Hand" Command="{Binding ResetFormCommand}"/>
                            <Button Content="✓  Confirm Loan (F5)" Height="32" Command="{Binding IssueBookCommand}"
                                    Padding="12,0" Background="{StaticResource AccentBrush}"
                                    Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#BFC2C5" BorderThickness="1" Padding="10" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="◷  Recent System Activity" FontWeight="Bold" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding RecentActivity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#ECEDEF" BorderThickness="0,1,0,0" Padding="0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" Foreground="#73777D" FontSize="10" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Reader}" FontWeight="SemiBold" FontSize="10"/>
                                                <TextBlock Text="{Binding BookTitle}" Foreground="#696D73" FontSize="9"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Action}" FontSize="9" FontWeight="Bold"
                                                       Foreground="#21804A" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Column="0" Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PageSummary}" Foreground="#55595E" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="|◀" Padding="8,3" Margin="3,0" ToolTip="First page"/>
                    <Button Content="◀ Prev" Padding="8,3" Margin="3,0"/>
                    <TextBlock Text="{Binding PageNumber}" MinWidth="24" TextAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="Next ▶" Padding="8,3" Margin="3,0"/>
                    <Button Content="▶|" Padding="8,3" Margin="3,0" ToolTip="Last page"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
