<Window x:Class="Presentation.Views.AdminDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLib - Admin Dashboard"
        Width="1440" Height="900" MinWidth="1024" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F4F6F8"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2463EB"/>
        <SolidColorBrush x:Key="TextBrush" Color="#263342"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#788493"/>
        <SolidColorBrush x:Key="LineBrush" Color="#E8ECF0"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#566273"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Width="22"
                                           VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F0F4FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E5ECF7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TableHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#778391"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="TableCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF5FF"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TableRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="31"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="228"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                    <Border Width="27" Height="27" CornerRadius="5" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="&#xE8A5;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Library Admin"
                               Margin="9,0,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Column="1" Margin="20,0,24,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#707D8B"/>
                        </Button>
                        <Button Margin="6,0,0,0" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Log out" Command="{Binding LogOutCommand}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="28" Height="28" CornerRadius="14" Background="#E8EDF3">
                                    <TextBlock Text="JD"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#526171"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding CurrentAdminName}"
                                           Margin="8,0,0,0"
                                           FontSize="12"
                                           Foreground="#526171"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="8,16">
                <TextBlock DockPanel.Dock="Bottom"
                           Text="SMARTLIB"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="#A1AAB5"
                           Margin="12,0,0,8"/>
                <StackPanel>
                    <Button Style="{StaticResource SidebarButtonStyle}" Content="Dashboard" Tag="&#xE80F;" Command="{Binding ShowSectionCommand}" CommandParameter="Dashboard"/>
                    <Button Style="{StaticResource SidebarButtonStyle}" Content="Catalog" Tag="&#xE8F1;" Command="{Binding ShowSectionCommand}" CommandParameter="Catalog"/>
                    <Button Style="{StaticResource SidebarButtonStyle}" Content="Readers" Tag="&#xE716;" Command="{Binding ShowSectionCommand}" CommandParameter="Readers"/>
                    <Button Style="{StaticResource SidebarButtonStyle}" Content="Debtors" Tag="&#xE8D4;" Command="{Binding ShowSectionCommand}" CommandParameter="Debtors"/>
                    <Button Style="{StaticResource SidebarButtonStyle}" Content="Settings" Tag="&#xE713;" Command="{Binding ShowSectionCommand}" CommandParameter="Settings"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="28,24,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="{Binding ActiveSection}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"/>
                <Button x:Name="RefreshButton"
                        Content="Refresh"
                        HorizontalAlignment="Right"
                        Padding="12,6"
                        Background="White"
                        BorderBrush="#DDE3E9"
                        BorderThickness="1"
                        FontSize="11"
                        Foreground="#526171"
                        Cursor="Hand"
                        Click="RefreshDashboard_Click"/>
            </Grid>

            <UniformGrid Grid.Row="1" Columns="3"
                         Visibility="{Binding IsDashboard, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="White" CornerRadius="4" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,12,0" Padding="16,13">
                    <StackPanel>
                        <TextBlock Text="Total Books" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="{Binding TotalBooks}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,3,0,2"/>
                        <TextBlock Text="+2.4% vs last month" FontSize="10" Foreground="#22A875"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="4" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,12,0" Padding="16,13">
                    <StackPanel>
                        <TextBlock Text="Active Readers" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="{Binding ActiveReaders}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,3,0,2"/>
                        <TextBlock Text="+1.1% vs last month" FontSize="10" Foreground="#22A875"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="4" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16,13">
                    <StackPanel>
                        <TextBlock Text="Overdue Items" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="{Binding OverdueItems}" FontSize="25" FontWeight="SemiBold" Foreground="#E5484D" Margin="0,3,0,2"/>
                        <TextBlock Text="+5.0% vs last month" FontSize="10" Foreground="#E5484D"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="4"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    Margin="0,18,0,0"
                    Visibility="{Binding IsDebtorsSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Debtors"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Height="30" Width="190" BorderBrush="#DDE3E9" BorderThickness="1" CornerRadius="3" Margin="0,0,8,0">
                                <DockPanel>
                                    <TextBlock Text="&#xE721;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               Foreground="#8994A0"
                                               VerticalAlignment="Center"
                                               Margin="9,0,0,0"/>
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="11"
                                             Foreground="{StaticResource TextBrush}"
                                             VerticalContentAlignment="Center"
                                             Padding="7,0"
                                             ToolTip="Search debtors"/>
                                </DockPanel>
                            </Border>
                            <ComboBox Width="125"
                                      Height="30"
                                      SelectedValue="{Binding SelectedOverdueFilter}"
                                      SelectedValuePath="Tag"
                                      FontSize="11"
                                      Foreground="#526171"
                                      ToolTip="Filter overdue loans">
                                <ComboBoxItem Content="All overdue" Tag="0"/>
                                <ComboBoxItem Content="7+ days" Tag="7"/>
                                <ComboBoxItem Content="30+ days" Tag="30"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding DebtorsPage}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource LineBrush}"
                              VerticalGridLinesBrush="Transparent"
                              BorderThickness="0"
                              Background="White"
                              RowHeaderWidth="0"
                              ColumnHeaderStyle="{StaticResource TableHeaderStyle}"
                              CellStyle="{StaticResource TableCellStyle}"
                              RowStyle="{StaticResource TableRowStyle}"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="READER NAME"
                                                Binding="{Binding ReaderName}"
                                                Width="1.35*"/>
                            <DataGridTextColumn Header="BOOK TITLE"
                                                Binding="{Binding BookTitle}"
                                                Width="3*"/>
                            <DataGridTextColumn Header="DAYS OVERDUE"
                                                Binding="{Binding DaysOverdue}"
                                                Width="1*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#E5484D"/>
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="0,0,12,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2" Margin="16,0">
                        <TextBlock Text="{Binding DebtorSummary}"
                                   FontSize="10"
                                   Foreground="#8994A0"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Previous" Padding="10,4" Margin="0,0,6,0" Background="White" BorderBrush="#DDE3E9" BorderThickness="1" FontSize="10" Foreground="#596675" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoToPreviousPage}"/>
                                <Button Content="Next" Padding="10,4" Background="White" BorderBrush="#DDE3E9" BorderThickness="1" FontSize="10" Foreground="#596675" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoToNextPage}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="White" CornerRadius="4"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    Margin="0,18,0,0"
                    Visibility="{Binding IsCatalog, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Catalog" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                     Width="220"
                                     Height="30"
                                     HorizontalAlignment="Right"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,0"
                                     VerticalContentAlignment="Center"
                                     FontSize="11"
                                     ToolTip="Search by title or author"/>
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding CatalogView}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False" BorderThickness="0"
                              Background="White" RowHeaderWidth="0"
                              ColumnHeaderStyle="{StaticResource TableHeaderStyle}"
                              CellStyle="{StaticResource TableCellStyle}"
                              RowStyle="{StaticResource TableRowStyle}">
                    <DataGrid.Columns>
                            <DataGridTextColumn Header="BOOK TITLE" Binding="{Binding Title}" Width="2*"/>
                            <DataGridTextColumn Header="AUTHOR(S)" Binding="{Binding Authors}" Width="2*"/>
                            <DataGridTextColumn Header="YEAR" Binding="{Binding PublicationYear}" Width="*"/>
                            <DataGridTextColumn Header="COPIES" Binding="{Binding CopiesCount}" Width="*"/>
                    </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="White" CornerRadius="4"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    Margin="0,18,0,0"
                    Visibility="{Binding IsReaders, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Readers" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                     Width="220"
                                     Height="30"
                                     HorizontalAlignment="Right"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,0"
                                     VerticalContentAlignment="Center"
                                     FontSize="11"
                                     ToolTip="Search by name or email"/>
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ReadersView}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False" BorderThickness="0"
                              Background="White" RowHeaderWidth="0"
                              ColumnHeaderStyle="{StaticResource TableHeaderStyle}"
                              CellStyle="{StaticResource TableCellStyle}"
                              RowStyle="{StaticResource TableRowStyle}">
                    <DataGrid.Columns>
                            <DataGridTextColumn Header="READER NAME" Binding="{Binding FullName}" Width="1.5*"/>
                            <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="2*"/>
                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="*"/>
                            <DataGridTextColumn Header="ACTIVE LOANS" Binding="{Binding ActiveLoans}" Width="*"/>
                    </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="White" CornerRadius="4"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    Margin="0,18,0,0" Padding="24"
                    Visibility="{Binding IsSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Library administration dashboard" Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="Database-backed statistics and lists refresh when the dashboard opens." Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
