<Window x:Class="Presentation.Views.ReaderDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLib - Reader Dashboard"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F4F6F8"
        FontFamily="Segoe UI">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Library Catalog" FontSize="26" FontWeight="Bold" Foreground="#173B59"/>
                <TextBlock Text="{Binding ReaderName, StringFormat='Welcome back, {0}!'}" FontSize="14" Foreground="#647687" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBox Width="450" Height="44" Padding="12,0" FontSize="14" VerticalContentAlignment="Center" 
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         BorderBrush="#D8E0E7" BorderThickness="1"/>
                <Button Content="Search" Command="{Binding SearchCommand}" Width="110" Height="44" Margin="10,0,0,0" 
                        Background="#246B8E" Foreground="White" FontSize="14" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

            <Button Grid.Column="2" Content="Log Out" Command="{Binding LogOutCommand}" Width="100" Height="44" 
                    Background="White" Foreground="#E5484D" BorderBrush="#E5484D" BorderThickness="1" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <DataGrid Grid.Row="1" ItemsSource="{Binding BooksList}" 
                  AutoGenerateColumns="False" IsReadOnly="True" 
                  Background="White" BorderBrush="#D8E0E7" BorderThickness="1" 
                  HeadersVisibility="Column" RowHeight="40" FontSize="14"
                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="3*"/>
                <DataGridTextColumn Header="AUTHOR(S)" Binding="{Binding Authors}" Width="2*"/>
                <DataGridTextColumn Header="GENRES" Binding="{Binding Genres}" Width="2*"/>
                <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="2*"/>
                <DataGridTextColumn Header="YEAR" Binding="{Binding PublicationYear}" Width="1*"/>
                <DataGridTextColumn Header="TOTAL COPIES" Binding="{Binding TotalCopies}" Width="1*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>