<Window x:Class="Presentation.Views.ReaderDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLib - Reader Dashboard"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F4F6F8"
        FontFamily="Segoe UI">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Welcome to your Reader Dashboard!" FontSize="32" FontWeight="Bold" Foreground="#173B59" TextAlignment="Center"/>
            <TextBlock Text="The book catalog and your active loans will be displayed here." FontSize="16" Foreground="#647687" TextAlignment="Center" Margin="0,10,0,30"/>
            <Button x:Name="LogoutBtn" Content="Log Out" Width="120" Height="40" FontSize="14" FontWeight="SemiBold" Background="White" Foreground="#E5484D" BorderBrush="#E5484D" BorderThickness="1" Cursor="Hand" Command="{Binding LogOutCommand}"/>
        </StackPanel>
    </Grid>
</Window>