<Window x:Class="Presentation.Views.ReaderDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLib - Book Search"
        Width="1440"
        Height="900"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#FFFFFF"
        FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#30333B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E8F3FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}}" Value="Book Search">
                    <Setter Property="Tag" Value="Book Search"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategoryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#F2F3F5"/>
            <Setter Property="Foreground" Value="#555963"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CategoryBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CategoryBorder" Property="Background" Value="#DDEEFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#343740"/>
            <Setter Property="Background" Value="#F3F3F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Background" Value="#0879D9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimaryBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Background" Value="#0568BC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FavoriteButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#52606D"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter Property="Foreground" Value="#E94F72"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F4F5F7">
            <Grid Margin="18,22,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="7" Background="#0879D9">
                        <TextBlock Text="▣" Foreground="White" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="SmartLib" Margin="9,0,0,0" FontSize="19" FontWeight="Bold" Foreground="#202333" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Command="{Binding SelectSectionCommand}" CommandParameter="Book Search">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="Book Search">
                                        <Setter Property="Background" Value="#E7F2FC"/>
                                        <Setter Property="Foreground" Value="#0879D9"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌕" FontSize="23" Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Book Search" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SelectSectionCommand}" CommandParameter="My Loans">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="My Loans">
                                        <Setter Property="Background" Value="#E7F2FC"/>
                                        <Setter Property="Foreground" Value="#0879D9"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▣" FontSize="16" Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="My Loans" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SelectSectionCommand}" CommandParameter="Favorites">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="Favorites">
                                        <Setter Property="Background" Value="#E7F2FC"/>
                                        <Setter Property="Foreground" Value="#0879D9"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="♡" FontSize="20" Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Favorites" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SelectSectionCommand}" CommandParameter="My Account">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="My Account">
                                        <Setter Property="Background" Value="#E7F2FC"/>
                                        <Setter Property="Foreground" Value="#0879D9"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="♙" FontSize="19" Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="My Account" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Need Assistance?" FontSize="12" FontWeight="Bold" Foreground="#202333"/>
                        <TextBlock Text="Ask at the main desk or tap 'Help' to start a direct chat with our librarian."
                                   Margin="0,7,0,10"
                                   FontSize="11"
                                   Foreground="#727780"
                                   TextWrapping="Wrap"/>
                        <Button Content="Contact Librarian"
                                HorizontalAlignment="Left"
                                Padding="10,6"
                                Background="#EAF4FF"
                                Foreground="#0879D9"
                                BorderThickness="0"
                                FontSize="11"
                                Cursor="Hand"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="38,25,40,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="46"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="34"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="14" Foreground="#737780" VerticalAlignment="Center">
                    <Run Text="Good afternoon, "/>
                    <Run Text="{Binding ReaderName}" FontWeight="SemiBold" Foreground="#292C38"/>
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="♧" Width="38" Height="38" Background="#F4F5F6" Foreground="#51545D" BorderThickness="0" FontSize="17" Cursor="Hand"/>
                    <Border Width="38" Height="38" Margin="12,0,0,0" CornerRadius="19" Background="#DCE8E5">
                        <TextBlock Text="{Binding ReaderInitials}" FontSize="13" FontWeight="SemiBold" Foreground="#365C52" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Visibility="{Binding IsBookSearch, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="#F3F3F4" CornerRadius="7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⌕" FontSize="24" Foreground="#686B73" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search by title or author"/>
                    </Grid>
                </Border>
                <Button Grid.Column="2" Content="Search" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SearchCommand}"/>
            </Grid>

            <ItemsControl Grid.Row="4" ItemsSource="{Binding Categories}" VerticalAlignment="Center"
                          Visibility="{Binding ShowCategories, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Name}"
                                Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding Name}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CategoryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="#0879D9"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="6" Visibility="{Binding IsBookSearch, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ResultSummary}" Foreground="#757982" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Sort by:" Foreground="#757982" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="130" Height="30" SelectedValue="{Binding SelectedSort}" SelectedValuePath="Content" FontSize="12">
                        <ComboBoxItem Content="Relevance"/>
                        <ComboBoxItem Content="Title A-Z"/>
                        <ComboBoxItem Content="Author"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsBookSearch, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding VisibleBooks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,18,20"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        BorderBrush="#E6E7EA"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="270"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Background="#ECEDEF">
                                            <Border Width="164" Height="226" Background="{Binding CoverBrush}" CornerRadius="2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Grid>
                                                    <Border Width="7" HorizontalAlignment="Left" Background="#30000000"/>
                                                    <Border Margin="15" BorderBrush="{Binding AccentBrush}" BorderThickness="1" Opacity="0.85"/>
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15">
                                                                    <TextBlock Text="{Binding Author}" Foreground="{Binding AccentBrush}" FontSize="8"
                                                                               TextAlignment="Center" TextWrapping="Wrap"/>
                                                        <Rectangle Height="1" Width="54" Fill="{Binding AccentBrush}" Margin="0,9,0,10"/>
                                                        <TextBlock Text="{Binding Title}" Foreground="{Binding AccentBrush}" FontSize="18"
                                                                   FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                                                                   FontFamily="Georgia"/>
                                                        <TextBlock Text="A SMARTLIB EDITION" Foreground="{Binding AccentBrush}"
                                                                   FontSize="7" TextAlignment="Center" Margin="0,12,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="9"
                                                    Style="{StaticResource FavoriteButtonStyle}"
                                                    Content="{Binding FavoriteGlyph}"
                                                    Command="{Binding ToggleFavoriteCommand}"
                                                    ToolTip="Toggle favorite"/>
                                        </Grid>
                                        <StackPanel Grid.Row="1" Margin="13,11,13,13">
                                            <Border Background="#F1F2F3" CornerRadius="3" Padding="6,3" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Category}" FontSize="9" Foreground="#555963"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Margin="0,8,0,2" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#202333" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Author}" FontSize="11" Foreground="#747780"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Margin="0,8,0,0" Padding="8,4" CornerRadius="4" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E0F5E5"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBorrowed}" Value="True">
                                                                <Setter Property="Background" Value="#F0F0F0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" FontSize="10">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#33824D"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBorrowed}" Value="True">
                                                                    <Setter Property="Foreground" Value="#70737B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Visibility="{Binding IsAccount, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="#F7F9FB"
                        BorderBrush="#E7EAEE"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="32"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Width="440">
                    <StackPanel>
                        <TextBlock Text="My Account" FontSize="24" FontWeight="Bold" Foreground="#202333"/>
                        <TextBlock Text="Your SmartLib reader profile" Margin="0,5,0,22" Foreground="#747780"/>
                        <TextBlock Text="Name" FontSize="11" Foreground="#747780"/>
                        <TextBlock Text="{Binding ReaderName}" Margin="0,3,0,16" FontSize="15" FontWeight="SemiBold" Foreground="#292C38"/>
                        <TextBlock Text="Membership" FontSize="11" Foreground="#747780"/>
                        <TextBlock Text="Reader" Margin="0,3,0,20" FontSize="15" FontWeight="SemiBold" Foreground="#292C38"/>
                        <Button Content="Log Out" Command="{Binding LogOutCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Left" Background="#FFFFFF" Foreground="#D34A54"
                                BorderBrush="#E5BFC1" BorderThickness="1"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="No books found. Try another search or category."
                           Visibility="{Binding ShowNoBooksMessage, Converter={StaticResource BooleanToVisibilityConverter}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#757982"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
