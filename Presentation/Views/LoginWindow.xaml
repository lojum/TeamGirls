<Window x:Class="Presentation.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log In - SmartLib"
        Width="920" Height="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="White"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#243746"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8E0E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PasswordInputStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#243746"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8E0E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#34495A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldErrorStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="45*"/>
            <ColumnDefinition Width="55*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0"
               Source="/Views/Images/left-panel-hero.jpg"
               Stretch="Fill"/>

        <Grid Grid.Column="1" Background="White">
            <StackPanel Width="380"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="40">
                <TextBlock Text="Welcome Back"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#173B59"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Please enter your credentials to access the library."
                           FontSize="14"
                           Foreground="#647687"
                           TextWrapping="Wrap"
                           Margin="0,0,0,30"/>

                <TextBlock Text="Email" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="EmailInput" Style="{StaticResource InputStyle}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock x:Name="EmailErrorText"
                           Text="Please enter a valid email address."
                           Style="{StaticResource FieldErrorStyle}"
                           Visibility="{Binding EmailErrorVisibility}"/>

                <TextBlock Text="Password"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,20,0,8"/>
                <PasswordBox x:Name="PasswordInput" Style="{StaticResource PasswordInputStyle}" PasswordChanged="PasswordInput_PasswordChanged"/>
                <TextBlock x:Name="PasswordErrorText"
                           Text="Please enter your password."
                           Style="{StaticResource FieldErrorStyle}"
                           Visibility="{Binding PasswordErrorVisibility}"/>
                
                <TextBlock x:Name="LoginErrorText"
                           Text="{Binding LoginErrorMessage}"
                           Style="{StaticResource FieldErrorStyle}"
                           Visibility="{Binding LoginErrorVisibility}"
                           Margin="0,10,0,0"/>

                <Button x:Name="LoginSubmitBtn"
                        Content="Log In"
                        Height="48"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Background="#246B8E"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,28,0,12"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsSubmitEnabled}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="BackBtn"
                        Content="Back to Welcome Screen"
                        Height="44"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Background="White"
                        Foreground="#246B8E"
                        BorderBrush="#D8E0E7"
                        BorderThickness="1"
                        Cursor="Hand"
                        Command="{Binding BackCommand}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>