<Window x:Class="SmartLib.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLib - Welcome"
        Width="920" Height="600" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" ClipToBounds="True">
            <Image Source="Images/library.jpg" Stretch="UniformToFill" />
        </Border>

        <Border Grid.Column="1" Background="White">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
                
                <TextBlock Text="Welcome back" FontSize="32" FontWeight="Bold" 
                           Foreground="#173B59" TextAlignment="Center" Margin="0,0,0,10"/>
                
                <TextBlock Text="Access your collections, manage loans, and explore thousands of titles." 
                           FontSize="14" Foreground="#647687" TextAlignment="Center" 
                           TextWrapping="Wrap" Margin="0,0,0,40"/>

                <Button x:Name="LoginBtn" Content="Log In" Height="50" FontSize="16" FontWeight="SemiBold" 
                        Background="#246B8E" Foreground="White" BorderThickness="0" Margin="0,0,0,15" Cursor="Hand"
                        Click="LoginBtn_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="RegisterBtn" Content="Register" Height="50" FontSize="16" FontWeight="SemiBold" 
                        Background="White" Foreground="#246B8E" BorderBrush="#246B8E" BorderThickness="2" 
                        Cursor="Hand" Click="RegisterBtn_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>